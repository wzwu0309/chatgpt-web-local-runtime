# Runtime artifacts land in the install target (~/.dsh-mcp-gateway), not in
# this repo. These rules also protect the payload dir if it is used in place.

# secrets / local config — env.conf.example is the template
env.conf
ADMIN_PIN.txt

# generated by the launchers (patch placeholder substitution)
*.resolved.cordis.yml

# Python
.venv/
__pycache__/
*.egg-info/

# Node installs
node_modules/
package-lock.json
pnpm-lock.yaml

# downloaded binary
bin/cloudflared*

# gateway + DSH runtime state
state/

# DSH_HOME runtime state — keep home/profiles/ templates, ignore generated
home/storages/
home/sessions/
home/profiles/*/node_modules/
.worktrees/
