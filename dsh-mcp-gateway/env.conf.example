# Configuration for start.sh / start.ps1 — copy to env.conf next to the
# launcher and fill in real values. Same KEY=VALUE format on every platform.
# env.conf contains secrets: never commit it.

# Owner PIN used at OAuth authorization (ChatGPT prompts for it once per connector).
DSH_MCP_GATEWAY_ADMIN_PIN=<generate-a-random-hex-pin>

# Absolute path to the cloudflared binary.
#   macOS/Linux: /Users/<you>/.dsh-mcp-gateway/bin/cloudflared
#   Windows:     C:\Users\<you>\.dsh-mcp-gateway\bin\cloudflared.exe
CLOUDFLARED=<absolute-path-to-cloudflared>

# Worker facade (fill in after deploying worker/_worker.js).
# Leave unset to expose the rotating trycloudflare URL directly.
WORKER_PUBLIC_URL=https://dsh-gw.<your-subdomain>.workers.dev

# Same random string as the Worker's ADMIN_SECRET secret.
UPSTREAM_ADMIN_SECRET=<random-secret-shared-with-worker>

# Launcher-side network requirement: the machine running start.sh/start.ps1
# must reach the Worker — it PUTs each fresh tunnel URL to /_upstream and
# runs health checks. If your network cannot reach *.workers.dev directly
# (e.g. mainland China: the domain is DNS-poisoned and SNI-filtered), set a
# local HTTP(S) proxy here:
#   PROXY=http://127.0.0.1:7890
# Only the launcher's own outbound calls use it — ChatGPT reaches the Worker
# from outside your network and never touches this proxy.
# Alternative: attach a custom domain to the Worker and point
# WORKER_PUBLIC_URL at it instead (needs a domain you own, hosted on
# Cloudflare — the CF side is free, the domain registration is not).
PROXY=

# Allowed workspace root — the only subtree workspace_switch may target
# (the root itself or any descendant). Resolved at launch; the launcher and
# the bridge plugin both refuse to start if the directory is missing —
# create it or point this elsewhere. Defaults to ~/data/workspace
# (%USERPROFILE%\data\workspace on Windows).
# WORKSPACE_ALLOWED_ROOT=/absolute/path/to/allowed/root

# Initial workspace root — the DSH host's launch cwd, i.e. the first
# workspace ChatGPT lands in. Defaults to <WORKSPACE_ALLOWED_ROOT>/default
# (~/data/workspace/default, %USERPROFILE%\data\workspace\default on Windows). The directory is
# created automatically when missing; an existing non-directory path at the
# resolved location fails the launch. Setting it explicitly still subjects
# it to the same auto-create rule, and it may point outside the allowed
# root (operator entry), though workspace_switch can never leave the
# subtree — see the architecture doc for that one-way door.
# Per-conversation workspace_switch bindings persist in
# home/storages/chatgpt-bridge/session-workspaces.json — this value is the
# root for calls without a session binding.
# WORKSPACE=/absolute/path/to/workspace

# Deployment-wide extra writable directories for DSH's workspace-write file
# sandbox. JSON array of absolute physical directory paths; entries must exist
# and must not be symlinked when used. These grants apply to every client and
# session. On macOS/Linux they apply both to sandboxed shell commands and DSH
# file tools; on Windows they apply to file tools only, not sandboxed processes.
# They do not extend WORKSPACE_ALLOWED_ROOT (workspace routing) and grant
# nothing under read-only mode.
# Example:
# DSH_SANDBOX_ADDITIONAL_WRITABLE_ROOTS='["/absolute/path/one","/absolute/path/two"]'

# Optional Devin integration (see devin/): ungate tool-subagent-devin.
# Set only after the @quonaro/dsh-plugin-devin plugin is installed.
# DSH_SUBAGENT_DEVIN=1
